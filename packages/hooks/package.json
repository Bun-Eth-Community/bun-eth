{
  "name": "@bun-eth/hooks",
  "version": "0.3.0",
  "description": "Custom React hooks for Web3 interactions with Bun-Eth",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@bun-eth/core": "^0.3.0",
    "@tanstack/react-query": "^5.17.19",
    "viem": "^2.7.8",
    "wagmi": "^2.16.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "ethereum",
    "hooks",
    "web3",
    "wagmi",
    "viem",
    "react"
  ],
  "license": "MIT"
}
