{
  "name": "@bun-eth/foundry-deployer",
  "version": "0.3.0",
  "description": "Foundry deployment utilities with contract hot reload support",
  "bin": {
    "foundry-deployer": "./dist/cli.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate": "bun run src/cli.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "glob": "^10.3.10",
    "prettier": "^3.2.4",
    "viem": "^2.7.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "foundry",
    "ethereum",
    "deployment",
    "hot-reload"
  ],
  "license": "MIT"
}
