# ========================================
# BUN-ETH ENVIRONMENT CONFIGURATION
# ========================================
#
# This is the single source of truth for environment variables.
# Copy this file to .env and configure for your setup.
#
# Usage:
#   1. cp .env.example .env
#   2. Update values as needed
#   3. Run: task dev:up
#
# For app-specific vars, Next.js will automatically load from this .env
# ========================================

# ----------------------------------------
# Port Configuration
# ----------------------------------------
# Consecutive ports for easy management
# Change all together if ports are in use
WEB_PORT=3000
API_PORT=3001
ANVIL_PORT=3002

# ----------------------------------------
# API Configuration
# ----------------------------------------
PORT=3001
NODE_ENV=development

# ----------------------------------------
# Blockchain Configuration
# ----------------------------------------

# Ethereum Node (Anvil - local development)
ANVIL_NODE=http://localhost:${ANVIL_PORT:-3002}
CHAIN_ID=31337

# Private Key Configuration
# For local development: Use Anvil's default private key (safe to commit)
# For testnet/mainnet: Replace with your own private key (⚠️ NEVER commit!)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ----------------------------------------
# Foundry Configuration
# ----------------------------------------
# Suppresses nightly build warnings
FOUNDRY_DISABLE_NIGHTLY_WARNING=true

# ----------------------------------------
# Frontend Configuration (Next.js)
# ----------------------------------------

# WalletConnect Project ID (optional)
# Get one at: https://cloud.reown.com/
# Leave empty to use only injected wallets (MetaMask, etc.)
NEXT_PUBLIC_WC_PROJECT_ID=

# Anvil port for frontend (must match ANVIL_PORT)
NEXT_PUBLIC_ANVIL_PORT=3002

# Contract Addresses (auto-generated after deployment)
# Run 'task contracts:deploy' to deploy and generate addresses
# These will be used by the frontend to interact with contracts
# NEXT_PUBLIC_CONTRACT_SIMPLE_STORAGE=

# ----------------------------------------
# Testnet Configuration (for deployment)
# ----------------------------------------

# Sepolia Testnet
# Get RPC URL from: https://infura.io or https://alchemy.com
SEPOLIA_RPC_URL=

# Etherscan API Key
# Get from: https://etherscan.io/myapikey
# Used for contract verification
ETHERSCAN_API_KEY=

# ----------------------------------------
# Optional: Multi-chain Deployment
# ----------------------------------------
# Base Testnet
BASESCAN_API_KEY=

# Arbitrum Testnet
ARBISCAN_API_KEY=

# ----------------------------------------
# Docker Configuration
# ----------------------------------------
COMPOSE_BAKE=true
