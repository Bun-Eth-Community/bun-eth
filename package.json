{
  "name": "bun-eth",
  "version": "0.1.0",
  "description": "A Bun-first scaffold for Ethereum projects",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "bun test packages/core packages/sdk",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint && sherif",
    "lint:fix": "turbo run lint:fix && sherif --fix --select highest",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.29.7",
    "@types/bun": "^1.1.10",
    "sherif": "^1.1.0",
    "turbo": "^2.5.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "bun@1.3.1",
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bun-Eth-Community/bun-eth.git"
  },
  "keywords": [
    "ethereum",
    "bun",
    "elysia",
    "foundry",
    "forge",
    "anvil",
    "web3",
    "scaffold"
  ],
  "mcp": {
    "servers": {
      "MCP_DOCKER": {
        "command": "docker",
        "args": [
          "mcp",
          "gateway",
          "run"
        ],
        "type": "stdio"
      }
    }
  }
}
